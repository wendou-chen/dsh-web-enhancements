{
  "name": "dsh-web-enhancements",
  "version": "1.4.0",
  "description": "DeepSeek Harness (DSH) Web & Desktop 全能增强套件 (工作区路径一键复制 / Shift+Tab模式轮转 / 悬浮控制球 / LaTeX公式一键复制与去重 / Mermaid交互渲染 / 划词引用 / 发送模式无缝切换 / 输入框智能折叠 / 任务提示音与可缩放通知窗 / 7阶启发式LaTeX语法自愈)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "author": "wendou-chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendou-chen/dsh-web-enhancements.git"
  },
  "homepage": "https://github.com/wendou-chen/dsh-web-enhancements#readme",
  "bugs": {
    "url": "https://github.com/wendou-chen/dsh-web-enhancements/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "workspace-path",
    "mode-cycle",
    "floating-ball",
    "latex",
    "mermaid",
    "quote-reply",
    "render-guardian",
    "enhancement-plugin"
  ],
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc <2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  }
}